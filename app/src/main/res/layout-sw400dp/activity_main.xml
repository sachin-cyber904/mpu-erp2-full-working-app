<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <!-- ✅ STATUS BAR STRIP -->
    <TextView
        android:id="@+id/topStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#C8102E"
        android:background="#FFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingBottom="8dp"
        android:elevation="4dp"/>
    <!-- ✅ SWIPE REFRESH WRAPPING WEBVIEW -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/spinnerImage"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_x="174dp"
                    android:layout_y="288dp"
                    android:src="@drawable/spinner_ring" />
            </WebView>

            <!-- ✅ CUSTOM LOADING SPINNER OVERLAY -->
            <LinearLayout
                android:id="@+id/loadingLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F0F4FF"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Loading..."
                    android:textColor="#001F5B"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"/>

            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>